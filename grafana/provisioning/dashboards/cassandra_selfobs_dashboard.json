        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "DS_TIMESCALEDB" },
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, round(100.0*count(*) FILTER (WHERE (explanation->>'fallback')::boolean) / NULLIF(count(*) FILTER (WHERE explanation IS NOT NULL),0),0) AS value FROM alerts",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Duree FIRING mediane (s)",
      "datasource": { "type": "postgres", "uid": "DS_TIMESCALEDB" },
      "description": "Duree mediane des episodes FIRING (resolved_at - opened_at).",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
